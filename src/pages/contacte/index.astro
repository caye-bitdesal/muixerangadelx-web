---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';
import { MAP_EMBED_URL } from '../../lib/site';
import { getNextAssaig, listAllEvents } from '../../lib/events';
import { defaultSubjectKeyFromContactUrl } from '../../lib/contact-form';

const locale = getLocaleFromUrl(Astro.url);
const defaultSubjectKey = defaultSubjectKeyFromContactUrl(Astro.url.searchParams);
const scrollToForm = Boolean(defaultSubjectKey);
const nextAssaig = getNextAssaig(await listAllEvents());
---

<BaseLayout locale={locale} overlayNav title={`${t(locale, 'contacte.title')} | Muixeranga d'Elx`}>
  <PageHero
    title={t(locale, 'contacte.title')}
    subtitle={t(locale, 'contacte.subtitle')}
    mapEmbedUrl={MAP_EMBED_URL}
    mapTitle={t(locale, 'contacte.map')}
  />
  <ContactSection
    locale={locale}
    defaultSubjectKey={defaultSubjectKey}
    nextAssaig={nextAssaig}
    scrollToForm={scrollToForm}
  />
</BaseLayout>
