---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import HistoriaPage from '../../../components/HistoriaPage.astro';
import { getLocaleFromUrl } from '../../../i18n/utils';
import {
  getHistoriaContent,
  HISTORIA_ELX_IMAGE,
  HISTORIA_HERO_YOUTUBE_ID,
} from '../../../lib/historia-content';

const locale = getLocaleFromUrl(Astro.url);
const copy = getHistoriaContent(locale);
---

<BaseLayout
  locale={locale}
  overlayNav
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogTitle={copy.metaTitle}
  ogDescription={copy.metaDescription}
  ogImage={HISTORIA_ELX_IMAGE}
>
  <PageHero
    title={copy.heroTitle}
    subtitle={copy.heroSubtitle}
    youtubeVideoId={HISTORIA_HERO_YOUTUBE_ID}
    youtubeTitle={copy.heroImageAlt}
    image={HISTORIA_ELX_IMAGE}
    imageAlt={copy.heroImageAlt}
    imageCover
  />
  <HistoriaPage locale={locale} />
</BaseLayout>
