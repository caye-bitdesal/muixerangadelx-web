---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { t } from '../../i18n/ui';
import { getLegalContent } from '../../lib/legal';

const locale = 'en' as const;
const content = getLegalContent('cookies', locale);
---

<BaseLayout
  locale={locale}
  title={`${content.title} | Muixeranga d'Elx`}
  description={t(locale, 'cookies.metaDescription')}
>
  <LegalPage locale={locale} page="cookies" />
</BaseLayout>
