---
import { listAllEvents } from '../../../lib/events';
import { buildEventSlugIndex, eventSlug, resolveEventParam } from '../../../lib/event-slug';
import { activitatsPath, eventDetailPath } from '../../../i18n/utils';

const locale = 'en' as const;

export async function getStaticPaths() {
  const events = await listAllEvents();
  if (!events.length) return [];
  const index = buildEventSlugIndex(events);
  return events.map((event) => ({ params: { id: event.id } }));
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect(activitatsPath(locale));
}

const events = await listAllEvents();
const index = buildEventSlugIndex(events);
const event = resolveEventParam(id, index, events);

if (!event) {
  return Astro.redirect(activitatsPath(locale));
}

return Astro.redirect(eventDetailPath(locale, eventSlug(event, index)), 301);
---
