---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinUsPage from '../../components/JoinUsPage.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { getJoinUsContent, JOIN_US_HERO_IMAGE } from '../../lib/join-us-content';
import { getNextAssaig, listAllEvents } from '../../lib/events';
import { buildEventSlugIndex, eventSlug } from '../../lib/event-slug';

const locale = getLocaleFromUrl(Astro.url);
const copy = getJoinUsContent(locale);
const events = await listAllEvents();
const nextAssaig = getNextAssaig(events);
const nextAssaigSlug = nextAssaig ? eventSlug(nextAssaig, buildEventSlugIndex(events)) : undefined;
const ogImage = JOIN_US_HERO_IMAGE;
---

<BaseLayout
  locale={locale}
  title={`${copy.metaTitle}`}
  description={copy.metaDescription}
  ogTitle={copy.metaTitle}
  ogDescription={copy.metaDescription}
  ogImage={ogImage}
>
  <JoinUsPage locale={locale} nextAssaig={nextAssaig} nextAssaigSlug={nextAssaigSlug} />
</BaseLayout>
