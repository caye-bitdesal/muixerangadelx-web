---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityDetailView from '../../components/ActivityDetailView.astro';
import { listAllEvents } from '../../lib/events';
import { getLocaleFromUrl, localizedPath } from '../../i18n/utils';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const events = await listAllEvents();
  const ids = events.length ? events.map((e) => e.id) : ['placeholder'];
  return ids.map((id) => ({ params: { id } }));
}

const locale = getLocaleFromUrl(Astro.url);
const { id } = Astro.params;

if (!id || id === 'placeholder') {
  return Astro.redirect(localizedPath(locale, '/activitats'));
}
---

<BaseLayout locale={locale} title={`${t(locale, 'nav.activitats')} | Muixeranga d'Elx`}>
  <ActivityDetailView locale={locale} eventId={id} />
</BaseLayout>
