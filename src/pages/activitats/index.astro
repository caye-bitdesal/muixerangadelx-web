---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivitiesCalendar from '../../components/ActivitiesCalendar.astro';
import ActivitiesApp from '../../components/ActivitiesApp.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout locale={locale} overlayNav title={`${t(locale, 'nav.activitats')} | Muixeranga d'Elx`}>
  <ActivitiesCalendar locale={locale} />
  <ActivitiesApp locale={locale} />
</BaseLayout>
