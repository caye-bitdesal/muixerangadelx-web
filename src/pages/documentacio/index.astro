---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DocsApp from '../../components/DocsApp.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout locale={locale} overlayNav title={`${t(locale, 'docs.title')} | Muixeranga d'Elx`}>
  <PageHero title={t(locale, 'docs.title')} subtitle={t(locale, 'docs.subtitle')} />
  <DocsApp locale={locale} />
</BaseLayout>
