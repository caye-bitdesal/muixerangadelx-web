---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DocsApp from '../../components/DocsApp.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout
  locale={locale}
  overlayNav
  title={`${t(locale, 'docs.title')} | Muixeranga d'Elx`}
  description={t(locale, 'docs.metaDescription')}
  ogTitle={`${t(locale, 'docs.title')} | Muixeranga d'Elx`}
  ogDescription={t(locale, 'docs.metaDescription')}
  ogImage="/images/heroes/documentacio.jpg"
>
  <PageHero
    title={t(locale, 'docs.title')}
    subtitle={t(locale, 'docs.subtitle')}
    image="/images/heroes/documentacio.jpg"
  />
  <DocsApp locale={locale} />
</BaseLayout>
