---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import HistoriaPage from '../../components/HistoriaPage.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import { getHistoriaContent, HISTORIA_ELX_IMAGE } from '../../lib/historia-content';

const locale = getLocaleFromUrl(Astro.url);
const copy = getHistoriaContent(locale);
---

<BaseLayout
  locale={locale}
  overlayNav
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogTitle={copy.metaTitle}
  ogDescription={copy.metaDescription}
  ogImage={HISTORIA_ELX_IMAGE}
>
  <PhotoHero
    image="/images/carousel/hero3.jpg"
    lead={copy.heroTitle}
    title={copy.heroSubtitle}
    perfScope="historia-hero"
  />
  <HistoriaPage locale={locale} />
</BaseLayout>
