---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActivityDetailView from '../../../components/ActivityDetailView.astro';
import { getEventById, listAllEvents } from '../../../lib/events';
import { localizedPath } from '../../../i18n/utils';

const locale = 'es' as const;

export async function getStaticPaths() {
  const events = await listAllEvents();
  const ids = events.length ? events.map((e) => e.id) : ['placeholder'];
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const event = id && id !== 'placeholder' ? await getEventById(id) : null;

if (!event) {
  return Astro.redirect(localizedPath(locale, '/activitats'));
}
---

<BaseLayout locale={locale} title={`${event.name} | Muixeranga d'Elx`}>
  <ActivityDetailView locale={locale} event={event} />
</BaseLayout>
