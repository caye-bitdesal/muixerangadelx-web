---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogApp from '../../../components/BlogApp.astro';
import { t } from '../../../i18n/ui';
import { getBlogPosts } from '../../../lib/blog';

const locale = 'es' as const;
const posts = await getBlogPosts(locale);
---

<BaseLayout
  locale={locale}
  overlayNav
  title={`${t(locale, 'blog.title')} | Muixeranga d'Elx`}
  description={t(locale, 'blog.metaDescription')}
  ogTitle={`${t(locale, 'blog.title')} | Muixeranga d'Elx`}
  ogDescription={t(locale, 'blog.metaDescription')}
  ogImage="/images/heroes/blog.jpg"
>
  <PageHero
    title={t(locale, 'blog.title')}
    subtitle={t(locale, 'blog.subtitle')}
    image="/images/heroes/blog.jpg"
  />
  <BlogApp locale={locale} posts={posts} />
</BaseLayout>
