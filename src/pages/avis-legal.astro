---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import { t } from '../i18n/ui';
import { getLegalContent } from '../lib/legal';

const locale = getLocaleFromUrl(Astro.url);
const content = getLegalContent('legal', locale);
---

<BaseLayout
  locale={locale}
  title={`${content.title} | Muixeranga d'Elx`}
  description={t(locale, 'legal.metaDescription')}
>
  <LegalPage locale={locale} page="legal" />
</BaseLayout>
