---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  title?: string;
  locale: Locale;
  overlayNav?: boolean;
  description?: string;
}

const {
  title = "Muixeranga d'Elx",
  locale,
  overlayNav = false,
  description = "Web oficial de la Muixeranga d'Elx",
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body id="body" class="min-h-screen flex flex-col bg-white text-elx-dark font-sans">
    <div id="body-inner" class="flex min-h-screen flex-col flex-1">
      <div id="page-wrap" class="flex flex-1 flex-col">
        <Navbar locale={locale} overlay={overlayNav} currentPath={Astro.url.pathname} />
        <main id="page-content" class:list={['flex-1', overlayNav ? '' : 'pt-[4.875rem]']}>
          <slot />
        </main>
        <Footer locale={locale} />
      </div>
    </div>
  </body>
</html>
