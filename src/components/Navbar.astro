---
import { t, languages, type Locale } from '../i18n/ui';
import { historiaPath, joinUsPath, localizedPath, switchLocalePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  overlay?: boolean;
  currentPath: string;
}

const { locale, overlay = false, currentPath } = Astro.props;

type PrimaryLink =
  | { key: 'nav.portada' | 'nav.activitats' | 'nav.blog'; path: string }
  | { key: 'nav.historia'; historia: true };

const primaryLinks: PrimaryLink[] = [
  { key: 'nav.portada', path: '/' },
  { key: 'nav.historia', historia: true },
  { key: 'nav.activitats', path: '/activitats' },
  { key: 'nav.blog', path: '/blog' },
];

function primaryHref(link: PrimaryLink): string {
  return 'historia' in link ? historiaPath(locale) : localizedPath(locale, link.path);
}

function isPrimaryLinkActive(link: PrimaryLink): boolean {
  if ('historia' in link) {
    const href = historiaPath(locale);
    return currentPath === href || currentPath.startsWith(`${href}/`);
  }
  return isPrimaryActive(link.path);
}

const contactHref = localizedPath(locale, '/contacte');
const joinHref = joinUsPath(locale);
const docsHref = localizedPath(locale, '/documentacio');

type ContactSubItem = {
  key: 'nav.contacte.info' | 'nav.unete' | 'nav.documentacio';
  href: string;
  id: 'contact' | 'join' | 'docs';
};

const contactSubItems: ContactSubItem[] = [
  { key: 'nav.contacte.info', href: contactHref, id: 'contact' },
  { key: 'nav.unete', href: joinHref, id: 'join' },
  { key: 'nav.documentacio', href: docsHref, id: 'docs' },
];

function isPrimaryActive(path: string): boolean {
  const localized = localizedPath(locale, path);
  if (path === '/') {
    return currentPath === localized || currentPath === `/${locale}`;
  }
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
}

function isContactSubActive(id: ContactSubItem['id']): boolean {
  if (id === 'contact') {
    return currentPath === contactHref || currentPath.startsWith(`${contactHref}/`);
  }
  if (id === 'join') {
    return currentPath === joinHref || currentPath.startsWith(`${joinHref}/`);
  }
  return currentPath === docsHref || currentPath.startsWith(`${docsHref}/`);
}

const contactMenuActive = contactSubItems.some((item) => isContactSubActive(item.id));
---

<header
  id="header"
  class:list={[
    'site-header header-fixed-top fixed top-0 left-0 right-0 w-full z-50',
    overlay ? 'header-transparent' : 'header-filled',
  ]}
  data-header-overlay={overlay ? 'true' : undefined}
>
  {overlay && <div class="header-gradient" aria-hidden="true"></div>}
  <div class="header-inner mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div id="logo" class="header-logo shrink-0">
      <a href={localizedPath(locale, '/')} class="inline-block">
        <img
          src="/images/logo.png"
          alt="Muixeranga d'Elx"
          class="logo-mask h-[70px] w-[70px]"
          width="70"
          height="70"
        />
      </a>
    </div>

    <div class="header-right">
      <nav class="main-menu hidden lg:block" aria-label="Main">
        <ul class="menu-nav">
          {
            primaryLinks.map((link) => (
              <li class:list={[isPrimaryLinkActive(link) && 'active']}>
                <a href={primaryHref(link)}>{t(locale, link.key)}</a>
              </li>
            ))
          }
          <li
            class:list={['menu-nav-dropdown', contactMenuActive && 'active']}
            data-nav-dropdown
          >
            <button
              type="button"
              class="menu-nav-dropdown-trigger"
              data-nav-dropdown-toggle
              aria-expanded="false"
              aria-haspopup="true"
              id="nav-contact-trigger"
            >
              {t(locale, 'nav.contacte')}
              <span class="menu-nav-dropdown-chevron" aria-hidden="true"></span>
            </button>
            <ul class="menu-nav-submenu" aria-labelledby="nav-contact-trigger">
              {
                contactSubItems.map((item) => (
                  <li class:list={[isContactSubActive(item.id) && 'active']}>
                    <a href={item.href}>{t(locale, item.key)}</a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </nav>

      <div class="header-attributes">
        <div class="header-lang hidden sm:flex items-center rounded-full bg-elx-dark px-1 py-1">
          {
            (Object.keys(languages) as Locale[]).map((lang, index, langs) => (
              <a
                href={switchLocalePath(Astro.url, lang)}
                class:list={[
                  'px-2.5 py-0.5 uppercase tracking-wide text-sm no-underline',
                  index < langs.length - 1 && 'border-r border-white/50',
                  lang === locale && 'lang-active',
                  lang !== locale && 'lang-inactive',
                ]}
                hreflang={lang}
              >
                {lang}
              </a>
            ))
          }
        </div>
        <button
          type="button"
          id="tt-m-menu-toggle-btn"
          class="text-white p-2"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menu"
        >
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden lg:hidden" aria-label="Mobile">
    <ul class="menu-nav-mobile">
      {
        primaryLinks.map((link) => (
          <li class:list={[isPrimaryLinkActive(link) && 'active']}>
            <a href={primaryHref(link)}>{t(locale, link.key)}</a>
          </li>
        ))
      }
      <li class:list={['mobile-nav-dropdown', contactMenuActive && 'active']} data-mobile-nav-dropdown>
        <button
          type="button"
          class="mobile-nav-dropdown-trigger"
          data-mobile-nav-toggle
          aria-expanded="false"
        >
          {t(locale, 'nav.contacte')}
          <span class="menu-nav-dropdown-chevron" aria-hidden="true"></span>
        </button>
        <ul class="mobile-nav-submenu hidden">
          {
            contactSubItems.map((item) => (
              <li class:list={[isContactSubActive(item.id) && 'active']}>
                <a href={item.href}>{t(locale, item.key)}</a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
    <div class="mobile-lang flex items-center rounded-full bg-elx-dark px-1 py-1 mx-4 mb-4 sm:hidden w-fit">
      {
        (Object.keys(languages) as Locale[]).map((lang, index, langs) => (
          <a
            href={switchLocalePath(Astro.url, lang)}
            class:list={[
              'px-3 py-1 uppercase text-sm no-underline',
              index < langs.length - 1 && 'border-r border-white/50',
              lang === locale && 'lang-active',
              lang !== locale && 'lang-inactive',
            ]}
            hreflang={lang}
          >
            {lang}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (header?.dataset.headerOverlay === 'true') {
    const threshold = 80;

    const updateHeaderOnScroll = () => {
      header.classList.toggle('header-scrolled', window.scrollY > threshold);
    };

    updateHeaderOnScroll();
    window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  }

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
  });

  const closeDesktopDropdowns = (except?: Element) => {
    document.querySelectorAll('[data-nav-dropdown].is-open').forEach((dropdown) => {
      if (except && dropdown === except) return;
      dropdown.classList.remove('is-open');
      const btn = dropdown.querySelector('[data-nav-dropdown-toggle]');
      btn?.setAttribute('aria-expanded', 'false');
    });
  };

  document.querySelectorAll('[data-nav-dropdown]').forEach((dropdown) => {
    const btn = dropdown.querySelector('[data-nav-dropdown-toggle]');
    btn?.addEventListener('click', (event) => {
      event.stopPropagation();
      const willOpen = !dropdown.classList.contains('is-open');
      closeDesktopDropdowns();
      if (willOpen) {
        dropdown.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('click', () => closeDesktopDropdowns());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDesktopDropdowns();
  });

  document.querySelectorAll('[data-mobile-nav-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('[data-mobile-nav-dropdown]');
      const submenu = group?.querySelector('.mobile-nav-submenu');
      if (!(submenu instanceof HTMLElement)) return;
      const open = submenu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      group?.classList.toggle('is-open', open);
    });
  });
</script>
