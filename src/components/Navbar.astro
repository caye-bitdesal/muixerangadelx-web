---
import { t, languages, type Locale } from '../i18n/ui';
import { localizedPath, switchLocalePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  overlay?: boolean;
  currentPath: string;
}

const { locale, overlay = false, currentPath } = Astro.props;

const links = [
  { key: 'nav.portada' as const, path: '/' },
  { key: 'nav.activitats' as const, path: '/activitats' },
  { key: 'nav.blog' as const, path: '/blog' },
  { key: 'nav.documentacio' as const, path: '/documentacio' },
  { key: 'nav.contacte' as const, path: '/contacte' },
];

function isActive(path: string): boolean {
  const localized = localizedPath(locale, path);
  if (path === '/') {
    return currentPath === localized || currentPath === `/${locale}`;
  }
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
}
---

<header
  id="header"
  class:list={[
    'site-header header-fixed-top fixed top-0 left-0 right-0 w-full z-50',
    overlay ? 'header-transparent' : 'header-filled',
  ]}
  data-header-overlay={overlay ? 'true' : undefined}
>
  {overlay && <div class="header-gradient" aria-hidden="true"></div>}
  <div class="header-inner mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div id="logo" class="header-logo shrink-0">
      <a href={localizedPath(locale, '/')} class="inline-block">
        <img
          src="/images/logo.png"
          alt="Muixeranga d'Elx"
          class="logo-mask h-[70px] w-[70px]"
          width="70"
          height="70"
        />
      </a>
    </div>

    <div class="header-right">
      <nav class="main-menu hidden lg:block" aria-label="Main">
        <ul class="menu-nav">
          {
            links.map((link) => (
              <li class:list={[isActive(link.path) && 'active']}>
                <a href={localizedPath(locale, link.path)}>{t(locale, link.key)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-attributes">
        <div class="header-lang hidden sm:flex items-center rounded-full bg-elx-dark px-1 py-1">
          {
            (Object.keys(languages) as Locale[]).map((lang, index, langs) => (
              <a
                href={switchLocalePath(Astro.url, lang)}
                class:list={[
                  'px-2.5 py-0.5 uppercase tracking-wide text-sm no-underline',
                  index < langs.length - 1 && 'border-r border-white/50',
                  lang === locale && 'lang-active',
                  lang !== locale && 'lang-inactive',
                ]}
                hreflang={lang}
              >
                {lang}
              </a>
            ))
          }
        </div>
        <button
          type="button"
          id="tt-m-menu-toggle-btn"
          class="text-white p-2"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menu"
        >
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden lg:hidden" aria-label="Mobile">
    <ul class="menu-nav-mobile">
      {
        links.map((link) => (
          <li class:list={[isActive(link.path) && 'active']}>
            <a href={localizedPath(locale, link.path)}>{t(locale, link.key)}</a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-lang flex items-center rounded-full bg-elx-dark px-1 py-1 mx-4 mb-4 sm:hidden w-fit">
      {
        (Object.keys(languages) as Locale[]).map((lang, index, langs) => (
          <a
            href={switchLocalePath(Astro.url, lang)}
            class:list={[
              'px-3 py-1 uppercase text-sm no-underline',
              index < langs.length - 1 && 'border-r border-white/50',
              lang === locale && 'lang-active',
              lang !== locale && 'lang-inactive',
            ]}
            hreflang={lang}
          >
            {lang}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (header?.dataset.headerOverlay === 'true') {
    const threshold = 80;

    const updateHeaderOnScroll = () => {
      header.classList.toggle('header-scrolled', window.scrollY > threshold);
    };

    updateHeaderOnScroll();
    window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  }

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
  });
</script>
