---
import { t, type Locale, type UiKey } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import { CONTACT_ADDRESS, CONTACT_EMAIL, CONTACT_MAP_URL, FORMSPREE_FORM_URL } from '../lib/site';
import { localizedPath } from '../i18n/utils';
import { CONTACT_SUBJECT_KEYS, type ContactSubjectKey } from '../lib/contact-form';
import NextAssaigBlock from './NextAssaigBlock.astro';
import type { MuixerangaEvent } from '../lib/events';

interface Props {
  locale: Locale;
  defaultSubjectKey?: ContactSubjectKey;
  nextAssaig: MuixerangaEvent | null;
  scrollToForm?: boolean;
}

const { locale, defaultSubjectKey, nextAssaig, scrollToForm = false } = Astro.props;

const subjectOptionKeys: Record<ContactSubjectKey, UiKey> = {
  join: 'contacte.form.subjectJoin',
  performance: 'contacte.form.subjectPerformance',
  press: 'contacte.form.subjectPress',
  sponsorship: 'contacte.form.subjectSponsorship',
  other: 'contacte.form.subjectOther',
};

const presetSubjectValue = defaultSubjectKey
  ? t(locale, subjectOptionKeys[defaultSubjectKey])
  : '';
---

<section id="contacte-form" class="bg-white py-16 px-4 sm:px-6 scroll-mt-24" data-contact-page>
  <div class="mx-auto max-w-7xl grid lg:grid-cols-2 gap-12">
    <div>
      <h2 class="text-3xl font-bold mb-6">{t(locale, 'contacte.heading')}</h2>
      <p class="text-lg">
        <a
          href={CONTACT_MAP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-start gap-2 text-elx-red underline underline-offset-2"
        >
          <img
            src="/images/icons/address.png"
            alt=""
            width="24"
            height="24"
            class="mt-0.5 h-6 w-6 shrink-0"
            loading="lazy"
          />
          <span>{CONTACT_ADDRESS}</span>
        </a>
      </p>
      <p class="mt-3">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex items-center gap-2 text-elx-red underline underline-offset-2"
        >
          <img
            src="/images/icons/email.png"
            alt=""
            width="24"
            height="24"
            class="h-6 w-6 shrink-0"
            loading="lazy"
          />
          {CONTACT_EMAIL}
        </a>
      </p>

      <div class="mt-6 flex flex-col gap-12 sm:mt-8">
        <NextAssaigBlock locale={locale} nextAssaig={nextAssaig} />
        <div>
          <h3 class="text-xl font-bold mb-4">{t(locale, 'contacte.follow')}</h3>
          <SocialLinks variant="dark" align="start" />
        </div>
      </div>
    </div>

    <form
      action={FORMSPREE_FORM_URL}
      method="POST"
      class="space-y-4"
      data-contact-form
      novalidate
    >
      <div>
        <label class="block text-sm font-medium mb-1" for="name">{t(locale, 'contacte.form.name')}*</label>
        <input id="name" name="name" required class="w-full border border-black/20 bg-neutral-100 px-3 py-2" />
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1" for="email">{t(locale, 'contacte.form.email')}*</label>
          <input id="email" name="email" type="email" required class="w-full border border-black/20 bg-neutral-100 px-3 py-2" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="phone">{t(locale, 'contacte.form.phone')}</label>
          <input id="phone" name="phone" type="tel" class="w-full border border-black/20 bg-neutral-100 px-3 py-2" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="subject">{t(locale, 'contacte.form.subject')}*</label>
        <select
          id="subject"
          name="subject"
          required
          class="w-full border border-black/20 bg-neutral-100 px-3 py-2"
        >
          {
            !presetSubjectValue ? (
              <option value="" disabled selected>
                {t(locale, 'contacte.form.subjectPlaceholder')}
              </option>
            ) : (
              <option value="" disabled hidden>
                {t(locale, 'contacte.form.subjectPlaceholder')}
              </option>
            )
          }
          {
            CONTACT_SUBJECT_KEYS.map((key) => {
              const label = t(locale, subjectOptionKeys[key]);
              const isSelected = presetSubjectValue === label;
              return isSelected ? (
                <option value={label} selected>
                  {label}
                </option>
              ) : (
                <option value={label}>
                  {label}
                </option>
              );
            })
          }
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="message">{t(locale, 'contacte.form.message')}*</label>
        <textarea id="message" name="message" rows="6" required class="w-full border border-black/20 bg-neutral-100 px-3 py-2"></textarea>
      </div>
      <label class="flex items-start gap-2 text-sm">
        <input type="checkbox" name="privacy" required class="mt-1" />
        <span>
          {t(locale, 'contacte.form.privacy')}
          (<a href={localizedPath(locale, '/politica-privacitat')} class="underline">{t(locale, 'footer.privacy')}</a>)
        </span>
      </label>
      <div class="flex justify-end">
        <button
          type="submit"
          class="inline-flex items-center gap-2 bg-elx-dark px-6 py-3 font-semibold uppercase tracking-wide text-white transition-colors hover:bg-elx-red disabled:cursor-not-allowed disabled:opacity-60"
        >
          <img
            src="/images/icons/send.png"
            alt=""
            width="20"
            height="20"
            class="h-5 w-5 shrink-0"
            loading="lazy"
          />
          {t(locale, 'contacte.form.submit')}
        </button>
      </div>
      <p class="text-sm text-elx-muted hidden" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script define:vars={{
  validationErrorMsg: t(locale, 'contacte.form.error'),
  sendingMsg: t(locale, 'contacte.form.sending'),
  successMsg: t(locale, 'contacte.form.success'),
  submitErrorMsg: t(locale, 'contacte.form.submitError'),
  formspreeUrl: FORMSPREE_FORM_URL,
  scrollToForm,
  presetSubjectValue,
}}>
  import { onPageLoad } from '../lib/on-page-load';

  onPageLoad(() => {
    const ac = new AbortController();
    const { signal } = ac;

    const subjectSelect = document.getElementById('subject');
    if (presetSubjectValue && subjectSelect instanceof HTMLSelectElement) {
      subjectSelect.value = presetSubjectValue;
    }

    if (scrollToForm) {
      const section = document.getElementById('contacte-form');
      const nameField = document.getElementById('name');
      section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => nameField?.focus(), 400);
    }

    const form = document.querySelector('[data-contact-form]');
    const status = document.querySelector('[data-form-status]');
    const submitBtn = form?.querySelector('[type="submit"]');

    const setStatus = (message: string, type = 'neutral') => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-green-700', 'text-red-700', 'text-elx-muted');
      if (type === 'success') status.classList.add('text-green-700');
      else if (type === 'error') status.classList.add('text-red-700');
      else status.classList.add('text-elx-muted');
    };

    form?.addEventListener(
      'submit',
      async (e) => {
        e.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        if (!form.checkValidity()) {
          setStatus(validationErrorMsg, 'error');
          form.reportValidity();
          return;
        }

        submitBtn?.setAttribute('disabled', 'true');
        setStatus(sendingMsg);

        const formData = new FormData(form);
        formData.delete('privacy');

        try {
          const res = await fetch(formspreeUrl, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          if (res.ok) {
            setStatus(successMsg, 'success');
            form.reset();
          } else {
            const data = await res.json().catch(() => null);
            const message =
              data?.errors?.map((error: { message: string }) => error.message).join(', ') ||
              submitErrorMsg;
            setStatus(message, 'error');
          }
        } catch {
          setStatus(submitErrorMsg, 'error');
        } finally {
          submitBtn?.removeAttribute('disabled');
        }
      },
      { signal },
    );

    return () => ac.abort();
  });
</script>
