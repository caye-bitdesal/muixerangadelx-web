---
import type { BlogContentBlock } from '../lib/blog';

interface Props {
  blocks: BlogContentBlock[];
}

const { blocks } = Astro.props;
---

<div class="space-y-8">
  {
    blocks.map((block) => {
      if (block.type === 'text') {
        return <p class="text-base sm:text-lg leading-relaxed whitespace-pre-line text-elx-dark">{block.text}</p>;
      }

      if (block.type === 'images' && block.images.length > 0) {
        const single = block.images.length === 1;
        return (
          <div
            class:list={[
              'gap-4',
              single ? 'grid grid-cols-1' : 'grid grid-cols-1 sm:grid-cols-2',
            ]}
          >
            {block.images.map((src) => (
              <img src={src} alt="" class="w-full object-cover bg-neutral-100" loading="lazy" />
            ))}
          </div>
        );
      }

      return null;
    })
  }
</div>
