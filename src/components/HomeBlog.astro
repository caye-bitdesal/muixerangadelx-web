---
import { t, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import BlogCard from './BlogCard.astro';

import type { BlogPostCard } from '../lib/blog';

interface Props {
  locale: Locale;
  posts: BlogPostCard[];
}

const { locale, posts } = Astro.props;
const items = posts.slice(0, 3);
---

<section class="bg-white py-16 px-4 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8">
      <h2 class="text-3xl sm:text-4xl font-bold">{t(locale, 'home.blog')}</h2>
      <p class="mt-2 text-elx-red">{t(locale, 'home.blog.subtitle')}</p>
    </div>

    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:flex lg:gap-6 lg:overflow-x-auto lg:pb-2"
    >
      {
        items.map((post) => (
          <div class="min-w-0 lg:shrink-0 lg:w-[calc((100%-3rem)/3)] [&_.blog-card]:h-full">
            <BlogCard
              locale={locale}
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.date}
              coverImage={post.coverImage}
              readLabel={t(locale, 'blog.read')}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href={localizedPath(locale, '/blog')}
        class="inline-block bg-elx-dark text-white px-6 py-3 font-semibold hover:bg-elx-red transition-colors"
      >
        {t(locale, 'home.seeAll')}
      </a>
    </div>
  </div>
</section>
