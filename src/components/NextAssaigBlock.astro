---
import { t, type Locale } from '../i18n/ui';
import { getJoinUsContent } from '../lib/join-us-content';
import { activitatsAssaigFilterPath, eventDetailPath } from '../i18n/utils';
import { eventMapLink, formatEventDateTime, type MuixerangaEvent } from '../lib/events';

interface Props {
  locale: Locale;
  nextAssaig: MuixerangaEvent | null;
  /** Canonical URL slug (from {@link buildEventSlugIndex}). */
  eventSlugValue?: string;
}

const { locale, nextAssaig, eventSlugValue } = Astro.props;
const copy = getJoinUsContent(locale);
const detailHref =
  nextAssaig && eventSlugValue ? eventDetailPath(locale, eventSlugValue) : null;
---

<div class="next-assaig-block">
  {
    nextAssaig && detailHref ? (
      <div class="rounded-lg border border-elx-dark/10 bg-neutral-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-wide text-elx-red">
          {copy.nextRehearsalLabel}
        </p>
        <p class="mt-2 text-xl font-bold">{nextAssaig.name}</p>
        <p class="mt-1">{formatEventDateTime(nextAssaig.date, locale)}</p>
        {nextAssaig.address ? (
          <a
            href={eventMapLink(nextAssaig.address)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex max-w-full items-start gap-2 text-elx-muted no-underline transition-colors hover:text-elx-dark"
            aria-label={`${t(locale, 'activitats.detail.openMap')}: ${nextAssaig.address}`}
          >
            <img
              src="/images/icons/map-address.png"
              alt=""
              width={32}
              height={32}
              class="mt-0.5 shrink-0"
              loading="lazy"
            />
            <span class="mt-[7px] min-w-0 leading-snug">{nextAssaig.address}</span>
          </a>
        ) : null}
        <div class="mt-4 flex flex-wrap gap-3">
          <a
            href={detailHref}
            class="inline-flex bg-elx-dark px-4 py-2 text-sm font-semibold uppercase tracking-wide text-white hover:bg-elx-red"
          >
            {copy.ctaEventDetail}
          </a>
          <a
            href={activitatsAssaigFilterPath(locale)}
            class="inline-flex border border-elx-dark px-4 py-2 text-sm font-semibold uppercase tracking-wide text-elx-dark hover:bg-elx-dark hover:text-white"
          >
            {copy.ctaAllRehearsals}
          </a>
        </div>
      </div>
    ) : (
      <p class="rounded-lg border border-dashed border-elx-dark/20 bg-neutral-50 p-5 text-elx-muted">
        {copy.noRehearsalMsg}
      </p>
    )
  }
</div>
