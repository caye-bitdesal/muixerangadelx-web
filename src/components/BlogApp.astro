---
import { t, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import BlogCard from './BlogCard.astro';
import type { BlogPostCard } from '../lib/blog';

interface Props {
  locale: Locale;
  posts: BlogPostCard[];
}

const { locale, posts } = Astro.props;
---

<section
  class="bg-white py-12 px-4 sm:px-6"
  data-blog-app
  data-posts={JSON.stringify(posts)}
  data-page-size="12"
  data-read={t(locale, 'blog.read')}
  data-locale={locale}
  data-empty={t(locale, 'blog.empty')}
  data-blog-base={localizedPath(locale, '/blog')}
>
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" data-blog-grid></div>
    <p class="text-center text-elx-muted py-10 hidden" data-blog-empty></p>
    <div data-blog-sentinel class="h-8 mt-8"></div>
  </div>
</section>

<noscript>
  <div class="mx-auto max-w-7xl px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16">
    {
      posts.slice(0, 12).map((post) => (
        <BlogCard
          locale={locale}
          slug={post.slug}
          title={post.title}
          description={post.description}
          date={post.date}
          coverImage={post.coverImage}
          readLabel={t(locale, 'blog.read')}
        />
      ))
    }
  </div>
</noscript>

<script>
  const root = document.querySelector('[data-blog-app]') as HTMLElement | null;
  if (root) {
    const posts = JSON.parse(root.dataset.posts || '[]') as Array<{
      slug: string;
      title: string;
      description: string;
      date: string;
      coverImage: string;
    }>;
    const pageSize = Number(root.dataset.pageSize || 12);
    const readLabel = root.dataset.read || '';
    const locale = root.dataset.locale || 'va';
    const blogBase = root.dataset.blogBase || '/blog';
    const emptyMsg = root.dataset.empty || '';
    const grid = root.querySelector('[data-blog-grid]')!;
    const emptyEl = root.querySelector('[data-blog-empty]') as HTMLElement;
    let shown = 0;

    const localeTag = locale === 'va' ? 'ca-ES-valencia' : locale === 'es' ? 'es-ES' : 'en-GB';

    const formatDate = (dateStr: string) =>
      new Intl.DateTimeFormat(localeTag, {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      }).format(new Date(dateStr));

    const card = (post: (typeof posts)[0]) => {
      const href = `${blogBase}/${post.slug}`;
      return `<article class="flex flex-col h-full">
      <a href="${href}" class="aspect-[16/10] overflow-hidden bg-[#1a1a1a] block">
        <img src="${post.coverImage}" alt="" class="h-full w-full object-cover" loading="lazy" />
      </a>
      <div class="flex flex-col flex-1 pt-4">
        <h3 class="text-xl font-bold leading-snug"><a href="${href}" class="hover:text-elx-red">${post.title}</a></h3>
        <time class="mt-2 text-sm text-[#666]" datetime="${post.date}">${formatDate(post.date)}</time>
        <p class="mt-3 text-sm leading-relaxed">${post.description}</p>
        <a href="${href}" class="mt-auto pt-5 self-start bg-elx-red text-white hover:bg-[#9a1a22] px-4 py-2 text-sm font-semibold uppercase tracking-wide transition-colors">${readLabel}</a>
      </div>
    </article>`;
    };

    const loadMore = () => {
      const next = posts.slice(shown, shown + pageSize);
      grid.insertAdjacentHTML('beforeend', next.map(card).join(''));
      shown += next.length;
      emptyEl.classList.toggle('hidden', posts.length > 0);
      emptyEl.textContent = emptyMsg;
    };

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting) && shown < posts.length) loadMore();
    });
    io.observe(root.querySelector('[data-blog-sentinel]')!);
    loadMore();
  }
</script>
