---
import { t, type Locale } from '../i18n/ui';
import { EVENTS_API } from '../lib/site';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const filters = [
  { id: 'all', label: t(locale, 'activitats.filters.all') },
  { id: 'assajos', label: t(locale, 'activitats.filters.assajos') },
  { id: 'actuacions', label: t(locale, 'activitats.filters.actuacions') },
  { id: 'trobades', label: t(locale, 'activitats.filters.trobades') },
  { id: 'tallers', label: t(locale, 'activitats.filters.tallers') },
];

const detailBase = localizedPath(locale, '/activitats');
const localeTag = locale === 'va' ? 'ca-ES-valencia' : locale === 'es' ? 'es-ES' : 'en-GB';
---

<section
  class="bg-white py-10 px-4 sm:px-6"
  data-activities-app
  data-api={EVENTS_API}
  data-detail-base={detailBase}
  data-locale={localeTag}
  data-empty={t(locale, 'activitats.empty')}
  data-loading={t(locale, 'activitats.loading')}
>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap gap-2 mb-8" role="tablist">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class:list={[
              'px-4 py-2 text-sm font-semibold border transition-colors',
              i === 0
                ? 'bg-elx-dark text-white border-elx-dark'
                : 'bg-white text-elx-dark border-elx-dark/30 hover:border-elx-dark',
            ]}
            data-filter={f.id}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
      data-activities-grid
    ></div>
    <p class="text-center text-elx-muted py-8 hidden" data-activities-empty></p>
    <p class="text-center text-elx-muted py-6" data-activities-status></p>
    <div data-activities-sentinel class="h-8"></div>
  </div>
</section>

<style>
  :global(.activity-card) {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 10%);
  }

  :global(.activity-card__media) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #fff;
  }

  :global(.activity-card__media img) {
    transition: transform 0.5s;
  }

  :global(.activity-card__media img.activity-card__img--natural) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  :global(.activity-card__media img.activity-card__img--cover) {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  :global(.activity-card:hover .activity-card__media img),
  :global(.activity-card:focus-within .activity-card__media img) {
    transform: scale(1.05);
  }

  :global(.activity-card__overlay) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding: 1rem;
    color: #fff;
    text-align: center;
    background: rgb(0 0 0 / 85%);
    opacity: 0;
    transition: opacity 0.3s;
  }

  :global(.activity-card:hover .activity-card__overlay),
  :global(.activity-card:focus-within .activity-card__overlay) {
    opacity: 1;
  }

  :global(.activity-card__overlay .activity-card__date) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-elx-yellow);
  }

  :global(.activity-card__overlay .activity-card__title) {
    margin-top: 0.25rem;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
  }
</style>

<script>
  import { compareEventDates, parseEventDate, type EventDateInput } from '../lib/events';

  type Ev = {
    id: string;
    name: string;
    image?: string | null;
    date?: EventDateInput;
    type?: string;
  };

  const FALLBACK_TYPES = ['assajos', 'actuacions', 'trobades', 'tallers'];
  const root = document.querySelector('[data-activities-app]') as HTMLElement | null;
  if (!root) throw new Error('activities root missing');

  const api = root.dataset.api!;
  const detailBase = root.dataset.detailBase!;
  const localeTag = root.dataset.locale!;
  const emptyMsg = root.dataset.empty!;
  const loadingMsg = root.dataset.loading!;
  const grid = root.querySelector('[data-activities-grid]')!;
  const emptyEl = root.querySelector('[data-activities-empty]') as HTMLElement;
  const statusEl = root.querySelector('[data-activities-status]') as HTMLElement;
  const sentinel = root.querySelector('[data-activities-sentinel]')!;

  let allEvents: Ev[] = [];
  let lastId: string | null = null;
  let filter = 'all';
  let loading = false;
  let exhausted = false;

  const withDefaults = (event: Ev, index: number): Ev => {
    const parsed = parseEventDate(event.date);
    const base = new Date();
    base.setDate(base.getDate() + index * 3);
    const image =
      event.image && event.image.trim() !== '' && !event.image.includes('example.com')
        ? event.image
        : null;
    return {
      ...event,
      date: (parsed ?? base).toISOString(),
      type: event.type ?? FALLBACK_TYPES[index % FALLBACK_TYPES.length],
      image,
    };
  };

  const formatDate = (dateInput?: EventDateInput) => {
    const d = parseEventDate(dateInput);
    if (!d) return typeof dateInput === 'string' ? dateInput : '';
    return new Intl.DateTimeFormat(localeTag, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(d);
  };

  const filtered = () => {
    const items = filter === 'all' ? allEvents : allEvents.filter((e) => e.type === filter);
    return [...items].sort((a, b) => compareEventDates(a.date, b.date));
  };

  const notifyFilter = () => {
    window.dispatchEvent(
      new CustomEvent('activities:filter-changed', { detail: { filter } }),
    );
  };

  const fitCardImage = (img: HTMLImageElement) => {
    const media = img.closest('.activity-card__media') as HTMLElement | null;
    if (!media) return;

    const apply = () => {
      const cw = media.clientWidth;
      const ch = media.clientHeight;
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      if (!iw || !ih || !cw || !ch) return;

      const fitsNaturally = iw <= cw && ih <= ch;
      img.classList.toggle('activity-card__img--natural', fitsNaturally);
      img.classList.toggle('activity-card__img--cover', !fitsNaturally);
    };

    if (img.complete) apply();
    else img.addEventListener('load', apply, { once: true });
  };

  const fitCardImages = () => {
    grid.querySelectorAll('.activity-card__media img').forEach((img) => {
      fitCardImage(img as HTMLImageElement);
    });
  };

  const cardHtml = (event: Ev) => {
    const img = event.image || '/images/placeholders/event.svg';
    return `<a href="${detailBase}/${event.id}" class="activity-card">
      <div class="activity-card__media">
        <img src="${img}" alt="" loading="lazy" />
      </div>
      <div class="activity-card__overlay">
        <p class="activity-card__date">${formatDate(event.date)}</p>
        <h3 class="activity-card__title">${event.name}</h3>
      </div>
    </a>`;
  };

  const render = () => {
    const items = filtered();
    grid.innerHTML = items.map(cardHtml).join('');
    fitCardImages();
    emptyEl.classList.toggle('hidden', items.length > 0);
    emptyEl.textContent = emptyMsg;
    notifyFilter();
  };

  const loadMore = async () => {
    if (loading || exhausted) return;
    loading = true;
    statusEl.textContent = loadingMsg;
    try {
      const url = new URL(api);
      url.searchParams.set('limit', '12');
      if (lastId) url.searchParams.set('lastId', lastId);
      const res = await fetch(url.toString());
      const data = await res.json();
      const batch = (data.events || []).map((e: Ev, i: number) =>
        withDefaults(e, allEvents.length + i),
      );
      if (!batch.length) {
        exhausted = true;
      } else {
        allEvents = [...allEvents, ...batch];
        lastId = data.lastId ?? batch[batch.length - 1]?.id ?? null;
        // If API returns same set without pagination support, stop after first page growth stalls
        if (batch.length < 12) exhausted = true;
      }
      render();
    } catch {
      exhausted = true;
      render();
    } finally {
      loading = false;
      statusEl.textContent = '';
    }
  };

  root.querySelectorAll('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = (btn as HTMLElement).dataset.filter || 'all';
      root.querySelectorAll('[data-filter]').forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-elx-dark', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-elx-dark', active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-elx-dark', !active);
      });
      render();
    });
  });

  const io = new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) loadMore();
  });
  io.observe(sentinel);

  loadMore();

  window.addEventListener('resize', fitCardImages, { passive: true });
</script>
