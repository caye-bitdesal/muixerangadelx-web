---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const filters = [
  { id: 'all', label: t(locale, 'activitats.filters.all') },
  { id: 'assaig', label: t(locale, 'activitats.filters.assaig') },
  { id: 'actuacio', label: t(locale, 'activitats.filters.actuacio') },
  { id: 'altre', label: t(locale, 'activitats.filters.altre') },
];

const localeTag = locale === 'va' ? 'ca-ES-valencia' : locale === 'es' ? 'es-ES' : 'en-GB';
---

<section
  class="bg-white py-10 px-4 sm:px-6"
  data-activities-app
  data-locale={locale}
  data-locale-tag={localeTag}
  data-empty={t(locale, 'activitats.empty')}
  data-loading={t(locale, 'activitats.loading')}
>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap gap-2 mb-8" role="tablist">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class:list={[
              'px-4 py-2 text-sm font-semibold border transition-colors',
              i === 0
                ? 'bg-elx-dark text-white border-elx-dark'
                : 'bg-white text-elx-dark border-elx-dark/30 hover:border-elx-dark',
            ]}
            data-filter={f.id}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 p-1 overflow-visible"
      data-activities-grid
    ></div>
    <p class="text-center text-elx-muted py-8 hidden" data-activities-empty></p>
    <p class="text-center text-elx-muted py-6" data-activities-status></p>
  </div>
</section>

<script>
  import {
    compareEventDates,
    eventDateKey,
    eventInMonth,
    listAllEvents,
    normalizeEventType,
    parseEventDate,
    type EventDateInput,
  } from '../lib/events';
  import { fitActivityCardImages } from '../lib/activity-card';
  import { buildEventSlugIndex, eventSlug } from '../lib/event-slug';
  import { eventDetailPath } from '../i18n/utils';
  import type { Locale } from '../i18n/ui';
  import { onPageLoad } from '../lib/on-page-load';

  type Ev = {
    id: string;
    name: string;
    image?: string | null;
    date?: EventDateInput;
    type?: string;
  };

  onPageLoad(() => {
  const root = document.querySelector('[data-activities-app]') as HTMLElement | null;
  if (!root) return;

  const ac = new AbortController();
  const { signal } = ac;
  let cancelled = false;

  const pageLocale = (root.dataset.locale ?? 'va') as Locale;
  const localeTag = root.dataset.localeTag!;
  const emptyMsg = root.dataset.empty!;
  const loadingMsg = root.dataset.loading!;
  const grid = root.querySelector('[data-activities-grid]')!;
  const emptyEl = root.querySelector('[data-activities-empty]') as HTMLElement;
  const statusEl = root.querySelector('[data-activities-status]') as HTMLElement;

  const now = new Date();
  let allEvents: Ev[] = [];
  const VALID_FILTERS = new Set(['all', 'assaig', 'actuacio', 'altre']);
  const initialFilter = new URLSearchParams(window.location.search).get('filter');
  let filter =
    initialFilter && VALID_FILTERS.has(initialFilter) ? initialFilter : 'all';
  let visibleYear = now.getFullYear();
  let visibleMonth = now.getMonth();
  let selectedDateKey: string | null = null;
  let ready = false;
  let slugIndex = buildEventSlugIndex([]);

  const applyFilterButtonStyles = () => {
    root.querySelectorAll('[data-filter]').forEach((b) => {
      const active = (b as HTMLElement).dataset.filter === filter;
      b.classList.toggle('bg-elx-dark', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('border-elx-dark', active);
      b.classList.toggle('bg-white', !active);
      b.classList.toggle('text-elx-dark', !active);
    });
  };

  applyFilterButtonStyles();

  const formatDate = (dateInput?: EventDateInput) => {
    const d = parseEventDate(dateInput);
    if (!d) return typeof dateInput === 'string' ? dateInput : '';
    return new Intl.DateTimeFormat(localeTag, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(d);
  };

  const filtered = () => {
    const items = allEvents.filter((event) => {
      if (!eventInMonth(event.date, visibleYear, visibleMonth)) return false;
      return filter === 'all' || event.type === filter;
    });
    return [...items].sort((a, b) => compareEventDates(a.date, b.date));
  };

  const notifyFilter = () => {
    window.dispatchEvent(
      new CustomEvent('activities:filter-changed', { detail: { filter } }),
    );
  };

  const fitCardImages = () => fitActivityCardImages(grid);

  const cardHtml = (event: Ev, slugIndex: ReturnType<typeof buildEventSlugIndex>) => {
    const img = event.image || '/images/placeholders/event.svg';
    const dateKey = eventDateKey(event.date) ?? '';
    const slug = eventSlug(event as import('../lib/events').MuixerangaEvent, slugIndex);
    const href = eventDetailPath(pageLocale, slug);
    return `<a href="${href}" class="activity-card scroll-mt-28" data-event-id="${event.id}" data-date-key="${dateKey}">
      <div class="activity-card__media">
        <img src="${img}" alt="" loading="lazy" />
      </div>
      <div class="activity-card__overlay">
        <p class="activity-card__date">${formatDate(event.date)}</p>
        <h3 class="activity-card__title">${event.name}</h3>
      </div>
    </a>`;
  };

  const selectedCards = () =>
    selectedDateKey
      ? ([...grid.querySelectorAll(`[data-date-key="${selectedDateKey}"]`)] as HTMLElement[])
      : [];

  const applySelection = (scroll = false) => {
    grid.querySelectorAll('.activity-card--selected').forEach((card) => {
      card.classList.remove('activity-card--selected');
    });
    const cards = selectedCards();
    cards.forEach((card) => card.classList.add('activity-card--selected'));
    if (scroll && cards[0]) {
      cards[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    return cards;
  };

  const render = () => {
    if (!ready) return;
    const items = filtered();
    grid.innerHTML = items.map((event) => cardHtml(event, slugIndex)).join('');
    fitCardImages();
    emptyEl.classList.toggle('hidden', items.length > 0);
    emptyEl.textContent = emptyMsg;
    applySelection();
  };

  root.querySelectorAll('[data-filter]').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        filter = (btn as HTMLElement).dataset.filter || 'all';
        applyFilterButtonStyles();
        render();
        notifyFilter();
      },
      { signal },
    );
  });

  window.addEventListener(
    'activities:month-changed',
    ((event: CustomEvent<{ year: number; month: number }>) => {
      visibleYear = event.detail.year;
      visibleMonth = event.detail.month;
      selectedDateKey = null;
      render();
    }) as EventListener,
    { signal },
  );

  window.addEventListener(
    'activities:day-selected',
    ((event: CustomEvent<{ dateKey: string }>) => {
      selectedDateKey = event.detail.dateKey || null;
      applySelection(true);
    }) as EventListener,
    { signal },
  );

  window.addEventListener('resize', fitCardImages, { passive: true, signal });

  statusEl.textContent = loadingMsg;
  listAllEvents()
    .then((events) => {
      if (cancelled) return;
      allEvents = events.map((event) => ({
        id: event.id,
        name: event.name,
        image: event.image,
        date: event.date,
        type: normalizeEventType(event.type),
        slug: event.slug,
      }));
      slugIndex = buildEventSlugIndex(events);
      ready = true;
      render();
    })
    .catch(() => {
      if (cancelled) return;
      ready = true;
      render();
    })
    .finally(() => {
      if (!cancelled) statusEl.textContent = '';
    });

  return () => {
    cancelled = true;
    ac.abort();
  };
  });
</script>
