---
import { youtubeBackgroundEmbedUrl } from '../lib/blog-embeds';

interface Props {
  title: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
  /** Use cover cropping for photographic heroes (e.g. historia). */
  imageCover?: boolean;
  youtubeVideoId?: string;
  youtubeTitle?: string;
  /** Default true. Set false for sound on load (may be blocked by browser autoplay rules). */
  youtubeMuted?: boolean;
  mapEmbedUrl?: string;
  mapTitle?: string;
}

const {
  title,
  subtitle,
  image = '/images/placeholders/hero.svg',
  imageAlt = '',
  imageCover = false,
  youtubeVideoId,
  youtubeTitle = 'Vídeo',
  youtubeMuted = true,
  mapEmbedUrl,
  mapTitle = 'Mapa',
} = Astro.props;

const useMap = Boolean(mapEmbedUrl);
const useYoutube = Boolean(youtubeVideoId?.trim());
const youtubeEmbedSrc = useYoutube
  ? youtubeBackgroundEmbedUrl(youtubeVideoId!, { muted: youtubeMuted })
  : '';
---

<section class="relative h-[55vh] min-h-[360px] max-h-[560px] w-full overflow-hidden">
  {
    useMap ? (
      <iframe
        title={mapTitle}
        src={mapEmbedUrl}
        class="absolute inset-0 h-full w-full border-0 pointer-events-none select-none"
        loading="lazy"
        tabindex="-1"
        referrerpolicy="no-referrer-when-downgrade"
      />
    ) : useYoutube ? (
      <>
        <div class="page-hero__youtube-wrap" aria-hidden="true">
          <iframe
            class="page-hero__youtube page-hero__youtube--motion"
            src={youtubeEmbedSrc}
            title={youtubeTitle}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
            tabindex="-1"
          />
        </div>
        <img
          src={image}
          alt={imageAlt}
          class:list={[
            'page-hero__media page-hero__youtube-fallback absolute inset-0 h-full w-full',
            imageCover && 'page-hero__media--cover',
          ]}
        />
      </>
    ) : (
      <img
        src={image}
        alt={imageAlt}
        class:list={[
          'page-hero__media absolute inset-0 h-full w-full',
          imageCover && 'page-hero__media--cover',
        ]}
      />
    )
  }
  <div
    class:list={[
      'absolute inset-0 pointer-events-none',
      useMap
        ? 'bg-gradient-to-r from-elx-dark/90 via-elx-dark/55 to-elx-dark/10'
        : 'bg-elx-dark/45 mix-blend-multiply',
    ]}
  ></div>
  {
    !useMap && (
      <div class="absolute inset-0 bg-gradient-to-r from-elx-red/40 via-elx-yellow/20 to-elx-blue/30 pointer-events-none"></div>
    )
  }
  <div class="relative z-10 h-full flex flex-col justify-center px-6 sm:px-12 max-w-7xl mx-auto pointer-events-none">
    <h1 class="text-4xl sm:text-6xl font-bold text-white drop-shadow-md">{title}</h1>
    <p class="mt-4 inline-block w-fit bg-elx-dark/85 text-white px-4 py-2 text-sm sm:text-base">
      {subtitle}
    </p>
  </div>
</section>
