---
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  excerpt: string;
  date: string;
  image: string;
  readLabel: string;
  yellowButton?: boolean;
}

const { title, excerpt, date, image, readLabel, locale, yellowButton = false } = Astro.props;

const formatted = new Intl.DateTimeFormat(
  locale === 'va' ? 'ca-ES-valencia' : locale === 'es' ? 'es-ES' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' },
).format(new Date(date));
---

<article class="flex flex-col h-full w-full">
  <div class="aspect-[16/10] overflow-hidden bg-elx-dark">
    <img src={image} alt="" class="h-full w-full object-cover" loading="lazy" />
  </div>
  <div class="flex flex-col flex-1 pt-4">
    <h3 class="text-xl font-bold leading-snug">{title}</h3>
    <time class="mt-2 text-sm text-elx-muted" datetime={date}>{formatted}</time>
    <p class="mt-3 text-sm leading-relaxed line-clamp-3">{excerpt}</p>
    <button
      type="button"
      class:list={[
        'mt-auto pt-5 self-start px-4 py-2 text-sm font-semibold uppercase tracking-wide transition-colors cursor-default',
        yellowButton
          ? 'bg-elx-yellow text-black hover:bg-[#e6b02e]'
          : 'bg-elx-red text-white hover:bg-[#9a1a22]',
      ]}
      aria-disabled="true"
    >
      {readLabel}
    </button>
  </div>
</article>
