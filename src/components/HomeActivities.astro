---
import { t, type Locale } from '../i18n/ui';
import { activitatsPath, contactPerformancePath } from '../i18n/utils';
import type { MuixerangaEvent } from '../lib/events';
import { buildEventSlugIndex, eventSlug } from '../lib/event-slug';
import ActivityCard from './ActivityCard.astro';

interface Props {
  locale: Locale;
  events: MuixerangaEvent[];
}

const { locale, events } = Astro.props;
const items = events.slice(0, 3);
const slugIndex = buildEventSlugIndex(events);
---

<section id="home-activities" class="bg-elx-yellow py-16 px-4 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 text-center sm:text-left">
      <h2 class="text-3xl sm:text-4xl font-bold text-elx-dark">{t(locale, 'home.activitats')}</h2>
      <p class="mt-2 text-elx-red">{t(locale, 'home.activitats.subtitle')}</p>
    </div>

    <div class="grid grid-cols-2 gap-3 lg:flex lg:gap-4 lg:overflow-x-auto lg:pb-2">
      {
        items.map((event) => (
          <div class="min-w-0 lg:shrink-0 lg:w-[calc((100%-2rem)/3)] [&>a]:w-full">
            <ActivityCard locale={locale} event={event} slug={eventSlug(event, slugIndex)} overlay="always" />
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={activitatsPath(locale)}
        class="inline-block bg-elx-dark px-6 py-3 font-semibold text-white transition-colors hover:bg-elx-red"
      >
        {t(locale, 'home.seeAll')}
      </a>
      <a
        href={contactPerformancePath(locale)}
        class="inline-block bg-elx-dark px-6 py-3 font-semibold text-white transition-colors hover:bg-elx-red"
      >
        {t(locale, 'home.hire.cta')}
      </a>
    </div>
  </div>
</section>

<script>
  import { fitActivityCardImages } from '../lib/activity-card';
  import { onPageLoad } from '../lib/on-page-load';

  onPageLoad(() => {
    const section = document.querySelector('#home-activities');
    if (!section) return;

    const fit = () => fitActivityCardImages(section);
    fit();

    const ac = new AbortController();
    window.addEventListener('resize', fit, { passive: true, signal: ac.signal });
    return () => ac.abort();
  });
</script>
