---
import type { Locale } from '../i18n/ui';
import { formatEventDate, eventImage, type MuixerangaEvent } from '../lib/events';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
  event: MuixerangaEvent;
  /** Show date and title without hover (e.g. home page with more space). */
  overlay?: 'hover' | 'always';
}

const { locale, event, overlay = 'hover' } = Astro.props;
---

<a
  href={localizedPath(locale, `/activitats/${event.id}`)}
  class:list={['activity-card', overlay === 'always' && 'activity-card--overlay-always']}
>
  <div class="activity-card__media">
    <img src={eventImage(event)} alt={event.name} loading="lazy" />
  </div>
  <div class="activity-card__overlay">
    <p class="activity-card__date">{formatEventDate(event.date, locale)}</p>
    <h3 class="activity-card__title">{event.name}</h3>
  </div>
</a>
