---
import { t, type Locale } from '../i18n/ui';
import { EVENTS_API } from '../lib/events';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const monthNames = Array.from({ length: 12 }, (_, i) =>
  t(locale, `months.${i}` as Parameters<typeof t>[1]),
);
const weekdays = Array.from({ length: 7 }, (_, i) =>
  t(locale, `weekdays.${i}` as Parameters<typeof t>[1]),
);
---

<section
  class="relative bg-elx-dark text-white"
  data-activities-calendar
  data-api={EVENTS_API}
  data-months={JSON.stringify(monthNames)}
  data-weekdays={JSON.stringify(weekdays)}
>
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img src="/images/carousel/hero1.jpg" alt="" class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-elx-dark/70 to-elx-dark/90"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <h1 class="mb-6 text-center text-2xl sm:text-4xl font-bold capitalize" data-cal-title></h1>

    <div class="hidden">
      <span class="bg-elx-blue text-white font-bold"></span>
      <span class="bg-elx-red text-white font-bold"></span>
      <span class="bg-elx-yellow text-elx-dark font-bold"></span>
      <span class="ring-2 ring-white ring-offset-2 ring-offset-elx-dark cursor-pointer"></span>
    </div>

    <div class="activities-cal-shell">
      <button
        type="button"
        class="activities-cal-nav"
        data-cal-prev
        aria-label={t(locale, 'activitats.cal.prevMonth')}
      >
        <span class="activities-cal-nav-icon" aria-hidden="true">‹</span>
      </button>

      <div class="activities-cal-body" data-cal-swipe>
        <div
          class="grid grid-cols-7 gap-1 sm:gap-2 text-center text-xs sm:text-sm uppercase tracking-wide text-white/70 mb-2"
          data-cal-weekdays
        ></div>
        <div class="activities-cal-grid grid grid-cols-7 gap-1 sm:gap-2 p-1 sm:p-2" data-cal-grid></div>
      </div>

      <button
        type="button"
        class="activities-cal-nav"
        data-cal-next
        aria-label={t(locale, 'activitats.cal.nextMonth')}
      >
        <span class="activities-cal-nav-icon" aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</section>

<script>
  import {
    eventCalendarDayClass,
    eventDateKey,
    listAllEvents,
    normalizeEventType,
    resolveCalendarDayType,
    resolveCalendarDayTypes,
    shouldSplitCalendarDay,
    type EventDateInput,
    type EventType,
  } from '../lib/events';

  type EventLite = { date?: EventDateInput; type?: EventType };

  const root = document.querySelector('[data-activities-calendar]') as HTMLElement | null;
  if (root) {
    const months: string[] = JSON.parse(root.dataset.months || '[]');
    const weekdays: string[] = JSON.parse(root.dataset.weekdays || '[]');
    const titleEl = root.querySelector('[data-cal-title]')!;
    const gridEl = root.querySelector('[data-cal-grid]')!;
    const weekEl = root.querySelector('[data-cal-weekdays]')!;
    const swipeEl = root.querySelector('[data-cal-swipe]')!;
    let cursor = new Date();
    cursor.setDate(1);
    let allEvents: EventLite[] = [];
    let filter = 'all';
    let selectedDateKey: string | null = null;
    let lastNotifiedMonth: { year: number; month: number } | null = null;
    let touchStartX = 0;
    let touchStartY = 0;
    let trackingSwipe = false;

    weekEl.innerHTML = weekdays.map((d) => `<div>${d}</div>`).join('');

    const key = (y: number, m: number, d: number) =>
      `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;

    const filteredEvents = () =>
      filter === 'all' ? allEvents : allEvents.filter((event) => event.type === filter);

    const typesByDay = () => {
      const days = new Map<string, EventType[]>();
      for (const event of filteredEvents()) {
        const dateKey = eventDateKey(event.date);
        const type = normalizeEventType(event.type);
        if (!dateKey || !type) continue;
        const current = days.get(dateKey) ?? [];
        current.push(type);
        days.set(dateKey, current);
      }
      return days;
    };

    const notifyMonthChangeIfNeeded = () => {
      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      if (lastNotifiedMonth?.year === year && lastNotifiedMonth?.month === month) return;
      lastNotifiedMonth = { year, month };
      window.dispatchEvent(
        new CustomEvent('activities:month-changed', {
          detail: { year, month },
        }),
      );
    };

    const changeMonth = (delta: number) => {
      cursor.setMonth(cursor.getMonth() + delta);
      selectedDateKey = null;
      render();
    };

    const render = () => {
      const days = typesByDay();
      const y = cursor.getFullYear();
      const m = cursor.getMonth();
      titleEl.textContent = `${months[m]} ${y}`;
      const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Monday-first
      const daysInMonth = new Date(y, m + 1, 0).getDate();
      const today = new Date();
      const todayKey = key(today.getFullYear(), today.getMonth(), today.getDate());
      const cells: string[] = [];
      for (let i = 0; i < firstDow; i++) cells.push('<div></div>');
      for (let d = 1; d <= daysInMonth; d++) {
        const dateKey = key(y, m, d);
        const dayEventTypes = days.get(dateKey) ?? [];
        const dayTypes = resolveCalendarDayTypes(dayEventTypes);
        const dayType = resolveCalendarDayType(dayEventTypes);
        const isSplit = shouldSplitCalendarDay(dayEventTypes);
        const selected = selectedDateKey === dateKey;
        const isToday = dateKey === todayKey;
        const dayClasses = [
          'activities-cal-day aspect-square flex items-center justify-center text-sm sm:text-base border border-white/10',
          dayType ? 'activities-cal-day--event' : 'bg-white/5',
          isSplit ? 'activities-cal-day--split' : dayType ? eventCalendarDayClass(dayType) : '',
          isToday ? 'activities-cal-day--today' : '',
          selected ? 'activities-cal-day--selected border-white ring-2 ring-white ring-offset-2 ring-offset-elx-dark' : '',
        ]
          .filter(Boolean)
          .join(' ');
        const dayAttrs = dayType ? ` data-cal-day="${dateKey}" role="button" tabindex="0"` : '';
        const dayContent = isSplit
          ? `<span class="activities-cal-day__part activities-cal-day__part--left activities-cal-day__part--${dayTypes[0]}" aria-hidden="true"></span><span class="activities-cal-day__part activities-cal-day__part--right activities-cal-day__part--${dayTypes[1]}" aria-hidden="true"></span><span class="activities-cal-day__number">${d}</span>`
          : `${d}`;
        cells.push(`<div class="${dayClasses}"${dayAttrs}>${dayContent}</div>`);
      }
      gridEl.innerHTML = cells.join('');
      notifyMonthChangeIfNeeded();
    };

    const selectDay = (dateKey: string) => {
      selectedDateKey = dateKey;
      render();
      window.dispatchEvent(
        new CustomEvent('activities:day-selected', { detail: { dateKey } }),
      );
    };

    gridEl.addEventListener('click', (event) => {
      const cell = (event.target as HTMLElement).closest('[data-cal-day]');
      if (!(cell instanceof HTMLElement) || !cell.dataset.calDay) return;
      selectDay(cell.dataset.calDay);
    });

    gridEl.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const cell = (event.target as HTMLElement).closest('[data-cal-day]');
      if (!(cell instanceof HTMLElement) || !cell.dataset.calDay) return;
      event.preventDefault();
      selectDay(cell.dataset.calDay);
    });

    root.querySelector('[data-cal-prev]')?.addEventListener('click', () => changeMonth(-1));
    root.querySelector('[data-cal-next]')?.addEventListener('click', () => changeMonth(1));

    swipeEl.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1) return;
        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
        trackingSwipe = true;
      },
      { passive: true },
    );

    swipeEl.addEventListener(
      'touchend',
      (event) => {
        if (!trackingSwipe) return;
        trackingSwipe = false;
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;
        if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY)) return;
        changeMonth(deltaX < 0 ? 1 : -1);
      },
      { passive: true },
    );

    swipeEl.addEventListener(
      'touchcancel',
      () => {
        trackingSwipe = false;
      },
      { passive: true },
    );

    window.addEventListener('activities:filter-changed', ((e: CustomEvent<{ filter: string }>) => {
      const nextFilter = e.detail.filter || 'all';
      if (nextFilter === filter) return;
      filter = nextFilter;
      render();
    }) as EventListener);

    listAllEvents()
      .then((events) => {
        allEvents = events;
        render();
      })
      .catch(() => render());

    render();
  }
</script>
