---
import { localizedPath } from '../i18n/utils';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  eventId: string;
}

const { locale, eventId } = Astro.props;

const backHref = localizedPath(locale, '/activitats');
const labels = {
  date: t(locale, 'activitats.detail.date'),
  location: t(locale, 'activitats.detail.location'),
  openMap: t(locale, 'activitats.detail.openMap'),
  figures: t(locale, 'activitats.detail.figures'),
  figuresEmpty: t(locale, 'activitats.detail.figuresEmpty'),
  gallery: t(locale, 'activitats.detail.gallery'),
  galleryEmpty: t(locale, 'activitats.detail.galleryEmpty'),
};
---

<article
  class="bg-white"
  data-activity-detail
  data-event-id={eventId}
  data-back-href={backHref}
  data-locale={locale}
  data-labels={JSON.stringify(labels)}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-14">
    <a
      href={backHref}
      class="inline-block text-sm font-semibold uppercase tracking-wide text-elx-red hover:underline"
    >
      ← {t(locale, 'activitats.detail.back')}
    </a>

    <div class="mt-8" data-activity-detail-body>
      <p class="text-center text-elx-muted py-12">{t(locale, 'activitats.loading')}</p>
    </div>
  </div>
</article>

<script>
  import { fetchEventById } from '../lib/events';
  import { renderActivityDetailBody, type ActivityDetailLabels } from '../lib/activity-detail-render';

  const root = document.querySelector('[data-activity-detail]') as HTMLElement | null;
  if (!root) throw new Error('activity detail root missing');

  const eventId = root.dataset.eventId!;
  const backHref = root.dataset.backHref!;
  const locale = (root.dataset.locale ?? 'va') as 'va' | 'es' | 'en';
  const labels = JSON.parse(root.dataset.labels ?? '{}') as ActivityDetailLabels;
  const body = root.querySelector('[data-activity-detail-body]') as HTMLElement;

  fetchEventById(eventId)
    .then((event) => {
      if (!event) {
        window.location.replace(backHref);
        return;
      }
      body.innerHTML = renderActivityDetailBody(event, labels, locale);
      document.title = `${event.name} | Muixeranga d'Elx`;
    })
    .catch(() => {
      window.location.replace(backHref);
    });
</script>
