---
import { joinUsPath } from '../i18n/utils';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const href = joinUsPath(locale);
---

<aside
  class="mt-10 border border-black/10 bg-elx-yellow/25 px-6 py-8 sm:px-8"
  aria-label={t(locale, 'blog.chronicleCta.aria')}
>
  <p class="text-lg sm:text-xl font-semibold leading-snug text-elx-dark">
    {t(locale, 'blog.chronicleCta.lead')}
    <a href={href} class="text-elx-red underline-offset-2 hover:underline">
      {t(locale, 'blog.chronicleCta.link')}
    </a>
  </p>
</aside>
