---
import { t, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="bg-white py-16 px-4 sm:px-6">
  <div class="mx-auto max-w-7xl grid lg:grid-cols-2 gap-10 items-start">
    <div>
      <p class="text-elx-red font-semibold text-sm uppercase tracking-wide">
        {t(locale, 'home.quisom.label')}
      </p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold">{t(locale, 'home.quisom.title')}</h2>
    </div>
    <div>
      <p class="text-base leading-relaxed text-elx-dark/90">{t(locale, 'home.quisom.body')}</p>
      <a
        href={localizedPath(locale, '/contacte')}
        class="mt-8 inline-block bg-elx-dark text-white px-6 py-3 font-semibold hover:bg-elx-red transition-colors"
      >
        {t(locale, 'home.quisom.cta')}
      </a>
    </div>
  </div>
</section>
