---
import { t, type Locale } from '../i18n/ui';
import { joinUsPath } from '../i18n/utils';
import { HOME_VIDEO_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const paragraphs = t(locale, 'home.quisom.body').split('\n\n');
---

<section class="tt-section p-t-90 p-b-90 p-t-md-50 p-b-md-50 muixeranga-elx bg-white" id="quisom">
  <div class="tt-section-inner tt-wrap container">
    <div class="row p-t-0 p-b-90 p-b-md-50">
      <div class="col-12">
        <h2>{t(locale, 'home.quisom.label')}</h2>
      </div>

      <div class="col-12 texto">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <p>
          {t(locale, 'home.quisom.rehearsalPrefix')}
          <a href={joinUsPath(locale)} class="text-elx-red underline underline-offset-2 hover:opacity-90">
            {t(locale, 'home.quisom.rehearsalLink')}
          </a>
          {t(locale, 'home.quisom.rehearsalSuffix')}
        </p>

        <a href={joinUsPath(locale)} class="btn btn-primary m-t-30 m-b-0">
          {t(locale, 'home.quisom.cta')}
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="aspect-video overflow-hidden bg-neutral-900 shadow-xl">
        <video
          id="quisom-video"
          class="h-full w-full object-cover"
          src={HOME_VIDEO_URL}
          muted
          loop
          playsinline
          preload="none"
          poster="/images/events/correllengua.png"
          aria-label={t(locale, 'home.quisom.video')}
        ></video>
      </div>
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from '../lib/on-page-load';

  onPageLoad(() => {
    const video = document.getElementById('quisom-video');
    if (!(video instanceof HTMLVideoElement)) return;

    let started = false;

    const startPlayback = () => {
      if (started) return;
      started = true;
      video.preload = 'auto';
      if (video.readyState === 0) video.load();
      video.muted = true;
      void video.play().catch(() => {
        /* Autoplay blocked: poster stays visible */
      });
    };

    video.addEventListener(
      'error',
      () => {
        video.removeAttribute('src');
        video.load();
      },
      { once: true },
    );

    if (typeof IntersectionObserver === 'undefined') {
      startPlayback();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          startPlayback();
          observer.disconnect();
        }
      },
      { rootMargin: '120px' },
    );

    observer.observe(video);

    return () => observer.disconnect();
  });
</script>
