---
import { t, type Locale } from '../i18n/ui';
import { docs } from '../lib/docs';
import DocCard from './DocCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const filters = [
  { id: 'all', label: t(locale, 'docs.filters.all') },
  { id: 'manuales', label: t(locale, 'docs.filters.manuales') },
  { id: 'entrevistas', label: t(locale, 'docs.filters.entrevistas') },
];
---

<section class="bg-white py-12 px-4 sm:px-6" data-docs-app>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap gap-2 mb-8">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class:list={[
              'px-4 py-2 text-sm font-semibold border transition-colors',
              i === 0
                ? 'bg-elx-dark text-white border-elx-dark'
                : 'bg-white text-elx-dark border-elx-dark/30 hover:border-elx-dark',
            ]}
            data-doc-filter={f.id}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    {
      docs.length === 0 ? (
        <p class="text-elx-muted">{t(locale, 'docs.empty')}</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" data-docs-grid>
          {
            docs.map((doc) => (
              <div data-doc-card data-doc-type={doc.type}>
                <DocCard locale={locale} doc={doc} downloadLabel={t(locale, 'docs.download')} />
              </div>
            ))
          }
        </div>
      )
    }

    <p class="hidden text-elx-muted mt-8" data-docs-empty-filter>
      {t(locale, 'docs.empty')}
    </p>
  </div>
</section>

<script>
  const root = document.querySelector('[data-docs-app]');
  if (root) {
    const cards = [...root.querySelectorAll('[data-doc-card]')];
    const emptyMsg = root.querySelector('[data-docs-empty-filter]');

    const applyFilter = (filter) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.docType === filter;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      emptyMsg?.classList.toggle('hidden', visible > 0);
    };

    root.querySelectorAll('[data-doc-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.docFilter || 'all';
        root.querySelectorAll('[data-doc-filter]').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('bg-elx-dark', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-elx-dark', !active);
        });
        applyFilter(filter);
      });
    });
  }
</script>
