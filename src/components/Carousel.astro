---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const slides = [
  { src: '/images/carousel/hero1.jpg' },
  { src: '/images/carousel/hero2.jpg' },
  { src: '/images/carousel/hero3.jpg' },
  { src: '/images/carousel/hero4.jpg' },
  { src: '/images/carousel/hero5.jpg' },
];
---

<section class="carousel-hero relative w-full overflow-hidden bg-elx-dark" data-carousel>
  <div class="carousel-media absolute inset-0 overflow-hidden">
    {
      slides.map((slide, i) => (
        <img
          src={slide.src}
          alt=""
          class:list={[
            'carousel-slide absolute inset-0 h-full w-full max-w-none object-cover object-bottom transition-opacity duration-700',
            i === 0 ? 'opacity-100' : 'opacity-0',
          ]}
          data-carousel-slide
          data-index={i}
        />
      ))
    }
  </div>

  <div class="carousel-copy relative z-10 flex h-full flex-col justify-center px-6 sm:px-12 max-w-7xl mx-auto pt-16">
    <p class="carousel-lead font-bold text-white">{t(locale, 'home.carousel.lead')}</p>
    <h1 class="carousel-title font-bold text-white">
      {t(locale, 'home.carousel.title')}
    </h1>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class:list={[
            'h-2.5 w-2.5 rounded-full border border-white',
            i === 0 ? 'bg-white' : 'bg-transparent',
          ]}
          data-carousel-dot
          data-index={i}
          aria-label={`Slide ${i + 1}`}
        />
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector('[data-carousel]');
  if (root) {
    const slideEls = [...root.querySelectorAll<HTMLImageElement>('[data-carousel-slide]')];
    const dots = [...root.querySelectorAll('[data-carousel-dot]')];
    let index = 0;

    const setCarouselSize = () => {
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      let maxImageHeight = 0;

      for (const img of slideEls) {
        if (!img.naturalWidth || !img.naturalHeight) continue;
        const scaledHeight = viewportWidth * (img.naturalHeight / img.naturalWidth);
        maxImageHeight = Math.max(maxImageHeight, scaledHeight);
      }

      if (maxImageHeight <= 0) return;

      const height = Math.min(viewportHeight, maxImageHeight);
      root.style.height = `${height}px`;
    };

    const whenImagesReady = slideEls.map(
      (img) =>
        new Promise<void>((resolve) => {
          if (img.complete) {
            resolve();
            return;
          }
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        }),
    );

    Promise.all(whenImagesReady).then(setCarouselSize);

    window.addEventListener('resize', setCarouselSize, { passive: true });
    window.visualViewport?.addEventListener('resize', setCarouselSize, { passive: true });

    const show = (next: number) => {
      index = (next + slideEls.length) % slideEls.length;
      slideEls.forEach((el, i) => {
        el.classList.toggle('opacity-100', i === index);
        el.classList.toggle('opacity-0', i !== index);
      });
      dots.forEach((el, i) => {
        el.classList.toggle('bg-white', i === index);
        el.classList.toggle('bg-transparent', i !== index);
      });
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const i = Number((dot as HTMLElement).dataset.index);
        show(i);
      });
    });

    setInterval(() => show(index + 1), 6000);
  }
</script>
