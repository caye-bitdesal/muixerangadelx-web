---
import { t, type Locale } from '../i18n/ui';
import { joinUsPath } from '../i18n/utils';
import PhotoHero from './PhotoHero.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<PhotoHero
  image="/images/carousel/hero2.jpg"
  lead={t(locale, 'home.carousel.lead')}
  title={t(locale, 'home.carousel.title')}
  cta={{ href: joinUsPath(locale), label: t(locale, 'home.carousel.ctaTry') }}
  perfScope="carousel"
/>
